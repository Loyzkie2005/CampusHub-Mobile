# Miscellaneous
*.class
*.log
*.pyc
*.swp
.env
.env.*
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local editor/assistant state and temporary evidence.
**/.agents/
**/.claude/
**/.codex/
**/.copilot/
**/.gemini/
**/.impeccable/
**/.obsidian/
**/.vscode/
**/agent/
**/skills-lock.json
**/__pycache__/
**/.dart_tool/
**/node_modules/
/.firebase/
/.gradle-user-home/
/scratch/
/tmp/

# Private credentials and signing keys stay local.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/key.properties
**/local.properties
**/*service-account*.json
**/*firebase-adminsdk*.json
**/*.sqlite3
**/*.dump
**/*.backup

# Historical backend/database experiments are not the Flutter client.
/backend/
/database/

# Recreated by Flutter tooling, never edited by hand.
**/generated_plugin_registrant.*
**/GeneratedPluginRegistrant.*
**/generated_plugins.cmake
